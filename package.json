{
  "name": "storybook-addon-discussion",
  "version": "0.1.7",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Leave comments for components and documentations",
  "keywords": [
    "discussion",
    "comments",
    "supabase",
    "storybook-addons",
    "appwrite.io"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hamed-farag/storybook-addon-discussion"
  },
  "author": "hamed-farag <hamed.farag.2009@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "*.mjs"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./storybook-static",
    "build": "tsup",
    "build:watch": "yarn build --watch",
    "test": "node --test --test-timeout=30000 tests/supabase-service.test.mjs",
    "test:manager": "node --test --test-timeout=60000 tests/native-manager.test.mjs",
    "start": "run-p build:watch \"storybook --quiet\"",
    "prerelease": "zx scripts/prepublish-checks.mjs",
    "release": "yarn build && auto shipit",
    "eject-ts": "zx scripts/eject-typescript.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^18.15.0",
    "@types/react": "^18.0.34",
    "@vitejs/plugin-react": "^4.7.0",
    "auto": "^10.3.0",
    "boxen": "^5.0.1",
    "dedent": "^0.7.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.62.1",
    "prettier": "^2.3.1",
    "prompts": "^2.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^3.0.2",
    "storybook": "^10.6.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "zx": "^1.14.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "storybook": "^10.6.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Storybook Discussion",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "supabase": "^1.100.1",
    "ts-dedent": "2.2.0",
    "yup": "^1.3.2"
  },
  "packageManager": "yarn@4.18.1"
}
